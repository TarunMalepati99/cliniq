# Copy to .env. Never commit real secrets.
POSTGRES_USER=cliniq
POSTGRES_PASSWORD=change-me
CLINIQ_READER_PASSWORD=change-me-too
# dev: accepts documented non-secret dev tokens (dev-admin-token, dev-researcher-token, ...)
# any other value: only tokens from CLINIQ_API_TOKENS are accepted
CLINIQ_ENV=dev
# Format: sha256(token):user:role,...   e.g.  python -c "import hashlib;print(hashlib.sha256(b'my-token').hexdigest())"
CLINIQ_API_TOKENS=
# Require a different user to approve a query than the one who created it
CLINIQ_REQUIRE_DISTINCT_APPROVER=false
# Optional: enables the LLM extractor (never writes SQL). Prices are optional and only used to report cost.
ANTHROPIC_API_KEY=
CLINIQ_LLM_MODEL=claude-sonnet-5-5
CLINIQ_LLM_PRICE_IN_PER_MTOK=
CLINIQ_LLM_PRICE_OUT_PER_MTOK=
# Fixed analytical date so age/lookback windows are reproducible
CLINIQ_AS_OF_DATE=2026-01-01
