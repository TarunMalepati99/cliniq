erDiagram
  SOURCE_FILES ||--o{ RAW_RECORDS : contains
  PIPELINE_RUNS ||--o{ RAW_RECORDS : landed_by
  PIPELINE_RUNS ||--o{ DEAD_LETTER : rejected_in
  RAW_RECORDS ||--o| PERSON : source_record_id
  RAW_RECORDS ||--o{ CONDITION_OCCURRENCE : source_record_id
  RAW_RECORDS ||--o{ MEASUREMENT : source_record_id
  PERSON ||--o{ CONDITION_OCCURRENCE : has
  PERSON ||--o{ MEASUREMENT : has
  PERSON ||--o{ DRUG_EXPOSURE : has
  PERSON ||--o{ PROCEDURE_OCCURRENCE : has
  PERSON ||--o{ GENOMIC_VARIANT : has
  PERSON ||--o{ NOTE : has
  NOTE ||--o{ NOTE_FACT : yields
  DEFINITIONS ||--o{ APPROVALS : reviewed_by
  DEFINITIONS ||--o{ COHORT_RUNS : executed_as
